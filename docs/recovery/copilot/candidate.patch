+def _matching_native_copilot_global_policy(root: Path, target: Path, pack: str) -> bool:
+    """Observe only the matching ordinary default-global instruction file."""
+    try:
+        if os.environ.get("COPILOT_HOME"):
+            return False
+        home = _resolve_global_home() / ".copilot"
+        path = home / "copilot-instructions.md"
+        if Path(os.path.abspath(target)).parent == home or _contains_reparse(path):
+            return False
+        if target.exists() and path.samefile(target):
+            return False  # A hardlink alias must not turn the global body into a reference.
+        before = path.lstat()
+        if not stat.S_ISREG(before.st_mode) or _is_reparse_metadata(before):
+            return False
+        codec = _provider_ownership_module(root)
+        with path.open("rb") as stream:
+            opened = os.fstat(stream.fileno())
+            if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
+                return False
+            payload = stream.read(codec.MAX_BYTES + 1)
+        after = path.lstat()
+        if ((after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
+                != (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
+                or len(payload) > codec.MAX_BYTES):
+            return False
+        text = payload.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
+        configuration = _provider_configuration_module(root)
+        bounds = configuration.owned_block(text, "copilot", _claude_document_context)
+        return bounds is not None and text[bounds[0]:bounds[1]] == pack.rstrip("\n")
+    except (OSError, ValueError, RuntimeError, UnicodeError):
+        return False  # Unproved availability keeps complete project rules.
+
