+def _merge_copilot_instructions(root: Path, target: Path, dry_run: bool, *,
+                                mutable_owner: _CreateOnlyMutablePath | None = None,
+                                expected_digest: str | None = None,
+                                prefer_global: bool = False) -> None:
+    """Compose source policy through existing document and transaction owners.
+
+    This producer does not choose a destination, enable discovery, register
+    hooks, or admit the client. The scoped lifecycle caller owns those steps
+    and supplies the previous receipt digest for an update.
+    """
+    if not dry_run and (mutable_owner is None or not mutable_owner.transaction.enabled):
+        raise ValueError("Copilot instruction writes require an installation transaction")
+    sources = (root / "shared/AGENTS.shared.md",
+               root / "adapters/copilot/AGENTS.copilot.md")
+    parts = [path.read_text(encoding="utf-8").rstrip() for path in sources]
+    if not all(parts):
+        raise ValueError("Empty Copilot instruction source")
+    payload = "\n\n".join(parts) + "\n"
+    configuration = _provider_configuration_module(root)
+    # Validate the full source frame even when a matching global body is reused.
+    pack = configuration.merge_owned_block(None, "copilot", payload, _claude_document_context)
+    if prefer_global and _matching_native_copilot_global_policy(root, target, pack):
+        payload = (
+            "# Orche project instructions\n"
+            "Client scope: GitHub Copilot and VS Code Local.\n"
+            "Installation mode: global-backed. The complete Orche policy is supplied "
+            "by the matching native default-global Copilot instructions.\n"
+            "Standalone use requires reinstalling with --standalone-instructions. "
+            "Project-specific instructions outside this block are retained.\n"
+        )
+    existing = _read_owned_text(target, mutable_owner, preserve_newlines=True)
+    content = configuration.merge_owned_block(
+        existing, "copilot", payload, _claude_document_context,
+        expected_digest=expected_digest)
+    if dry_run:
+        print(f"    [dry-run] would merge {target}")
+    else:
+        _write_owned_text(target, content, mutable_owner)
 
 
