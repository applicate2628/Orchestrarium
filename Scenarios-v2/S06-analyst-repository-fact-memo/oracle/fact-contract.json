    "allowed_change_surface",
    "must_not_touch",
    "score_profile",
    "overlay_flags"
  ],
  "required_bundle_paths": [
    "inputs/README.md",
    "inputs/task.md",
    "inputs/noisy-intake-notes.md",
    "inputs/bounded-scope.md",
