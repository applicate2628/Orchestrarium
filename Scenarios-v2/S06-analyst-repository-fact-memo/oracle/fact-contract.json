    "candidate/repo-snapshot/benchmarks/registry/scenario_catalog.py",
    "candidate/repo-snapshot/benchmarks/registry/score_profiles.py",
    "candidate/repo-snapshot/benchmarks/publication/write_results.py",
    "candidate/repo-snapshot/benchmarks/publication/legacy_score_profiles.py",
    "candidate/repo-snapshot/benchmarks/tools/export_legacy_index.py",
    "candidate/repo-snapshot/benchmarks/tools/export_role_matrix.py",
    "candidate/repo-snapshot/benchmarks/docs/legacy-routing-notes.md",
