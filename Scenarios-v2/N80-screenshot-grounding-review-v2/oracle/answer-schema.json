{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image_id", "findings", "non_findings"],
  "properties": {
    "image_id": {
      "type": "string",
      "const": "N80-screenshot-grounding-v2"
    },
    "findings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["component", "defect", "severity", "x", "y", "evidence"],
        "properties": {
          "component": {"type": "string"},
          "defect": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "x": {"type": "integer", "minimum": 0, "maximum": 1599},
          "y": {"type": "integer", "minimum": 0, "maximum": 1099},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "non_findings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
