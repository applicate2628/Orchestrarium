        "mandatory": true,
        "scope": "flow",
        "high": ["local preparation"],
        "low": ["review handoff", "blocking question", "returned", "ready to re-enter"]
      },
      "flow_sequence": {
        "type": "order_pairs",
        "points": 40,
        "scope": "flow",
        "pairs": [
          ["local preparation", "review handoff"],
          ["review handoff", "blocking question"],
          ["blocking question", "returned"],
          ["returned", "ready to re-enter"]
        ]
      },
      "publish_gating": {
        "type": "conjunction",
        "points": 40,
        "mandatory": true,
        "mandatory_min": 40,
        "scope": "ladder",
        "conjunction": [
          {"group": "publish", "any_of": ["publish approval", "publish step", "publish affordance", "publish"]},
          {"group": "gated", "any_of": ["unavailable until", "not available until", "only after", "gated", "blocked until", "hidden until", "not publishable", "withheld", "cannot publish until"]}
        ]
      }
    }
