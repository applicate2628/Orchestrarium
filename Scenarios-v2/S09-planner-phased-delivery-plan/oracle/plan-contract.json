    "overlay_flags"
  ],
  "required_metadata": {
    "id": "S09",
    "surface_id": "R09",
    "pack_id": "P02",
    "role_class": "planning",
    "artifact_type": "phase plan",
    "modality_family": "phased delivery planning",
    "allowed_change_surface": [
      "candidate/phase-plan.md"
    ],
    "must_not_touch": [
      "inputs/**",
      "oracle/**",
      "verifiers/**",
      "candidate/README.md"
    ],
    "score_profile": "owner, advisory, factual, design, planning",
    "overlay_flags": []
  },
  "required_bundle_files": [
    "inputs/README.md",
    "inputs/task.md",
    "inputs/accepted-brief.md",
    "inputs/accepted-design-package.md",
    "inputs/accepted-constraints.md",
    "candidate/README.md",
    "candidate/phase-plan.md",
    "oracle/README.md",
    "oracle/plan-contract.json",
    "oracle/expected-phase-order.md",
    "oracle/anti-patterns.md",
    "oracle/scoring-anchors.md",
    "verifiers/README.md",
    "verifiers/check_phase_plan.py"
  ],
  "required_plan_sections": [
    "# S09 Phase Plan",
    "## Planning goal",
    "## Accepted inputs",
    "## Boundaries and assumptions",
    "## Phase sequence",
    "## Cross-phase risks and mitigations",
    "## Verification and handoff gates",
    "## Deferred work",
    "## Gate decision"
  ],
  "required_phase_headings": [
    "### Phase 1 - JSON contract stabilization",
    "### Phase 2 - Dry-run preview and write-guard",
    "### Phase 3 - Verification, docs, and handoff"
  ],
  "required_phase_labels": [
    "- Scope:",
    "- File scope:",
    "- Dependencies:",
    "- Deliverable:",
    "- Tests and checks:",
    "- Rollback notes:"
  ],
  "phase_expectations": {
    "### Phase 1 - JSON contract stabilization": {
      "must_include": [
        "tools/status_snapshot.py",
        "tests/test_status_snapshot.py",
        "accepted packet"
      ]
    },
    "### Phase 2 - Dry-run preview and write-guard": {
      "must_include": [
        "tools/status_snapshot.py",
        "tests/test_status_snapshot.py",
        "Phase 1 PASS",
        "--dry-run"
      ]
    },
    "### Phase 3 - Verification, docs, and handoff": {
      "must_include": [
        "tools/status_snapshot.py",
        "tests/test_status_snapshot.py",
        "docs/cli/status-snapshot.md",
        "Phase 2 PASS"
      ]
    }
  },
  "required_input_references": [
    "inputs/accepted-brief.md",
    "inputs/accepted-design-package.md",
    "inputs/accepted-constraints.md"
  ],
  "required_keyword_groups": [
    [
      "status.snapshot.json"
    ],
    [
      "--text-summary"
    ],
    [
      "--dry-run"
    ],
    [
      "500-item fixture",
      "500 item fixture"
    ],
    [
      "$qa-engineer",
      "qa-engineer"
    ],
    [
      "$architecture-reviewer",
      "architecture-reviewer"
    ],
    [
      "rollback"
    ],
    [
      "dependencies"
    ],
    [
      "tests and checks"
    ]
  ],
  "required_section_terms": [
    {
      "section": "## Boundaries and assumptions",
      "required_terms": [
        "tools/status_snapshot.py",
        "tests/test_status_snapshot.py",
        "runners",
        "archive"
      ]
    },
    {
      "section": "## Cross-phase risks and mitigations",
      "required_terms": [
        "dry-run",
        "write",
        "rollback",
        "Phase 1",
        "Phase 2"
      ]
    },
    {
      "section": "## Verification and handoff gates",
      "required_terms": [
        "500-item",
        "$qa-engineer",
        "$architecture-reviewer",
        "handoff"
      ]
    }
  ],
  "valid_gate_decisions": [
    "PASS",
    "REVISE",
    "BLOCKED"
  ],
  "disallowed_markers": [
    "TODO",
    "diff --git",
    "```",
    "apply_patch"
  ],
  "disallowed_headings": [
    "## Confirmed facts",
    "## Decision",
    "## Findings"
  ],
  "derivation_scoring": {
    "mechanism": "derivation-dependency-ordering",
    "pass_threshold": 70,
    "max_points": 100,
    "note": "R4b: the fixed phase-heading order + phase_expectations are kept as a floor; on top of that the graded layer requires the DERIVED causal dependency (why Phase 2 needs Phase 1's stable JSON payload) and the explicit rejection of the seeded 'fold --dry-run into Phase 1' shortcut. Copying the fixed heading order without deriving the dependency, or following the shortcut, fails.",
    "phase2_block_start": "### Phase 2 - Dry-run preview and write-guard",
    "phase2_block_end": "### Phase 3 - Verification, docs, and handoff",
    "phase3_block_start": "### Phase 3 - Verification, docs, and handoff",
    "phase3_block_end": "## Cross-phase risks and mitigations",
    "components": {
      "phase2_dependency_derivation": {
        "points": 45,
        "mandatory_min": 30,
        "scope": "phase2_block",
        "conjunction": [
          {"group": "json_contract", "any_of": ["json contract", "json payload", "payload contract", "status.snapshot.json", "json shape", "payload shape"]},
          {"group": "stability", "any_of": ["stable", "stabil", "finalized", "explicit", "locked", "frozen", "established", "before the preview", "first"]},
          {"group": "preview_link", "any_of": ["dry-run", "write-guard", "write guard", "preview", "would-be payload", "returns the"]}
        ]
      },
      "phase3_dependency": {
        "points": 15,
        "scope": "phase3_block",
        "any_of": ["phase 2 pass", "after phase 2", "behavior is stable", "stable behavior", "verification route", "once behavior"]
      },
      "shortcut_rejection": {
        "points": 25,
        "mandatory_min": 15,
        "scope": "whole",
        "conjunction": [
          {"group": "shortcut_ref", "any_of": ["fold", "combine", "merge", "same phase", "one phase", "collapse", "save a phase", "reviewer suggest", "reviewer suggested", "raised suggestion", "shortcut"]},
          {"group": "reject", "any_of": ["reject", "not fold", "should not", "must not", "cannot ship", "only after", "kept separate", "separate phase", "not combine", "not be combined", "keep them separate", "declined", "not accepted"]}
        ]
      },
      "boundary_discipline": {
        "points": 15,
        "scope": "whole",
        "any_of": ["do not widen", "stays inside", "admitted", "not reopen", "no runners", "without widening", "bounded", "inside the accepted"]
      }
    }
  }
}
