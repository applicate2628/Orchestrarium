#!/usr/bin/env python3
"""Load the reviewed modular Stage 0 verifier with trusted Pytest events."""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Mapping, Sequence


def _load(name: str, filename: str):
    path = Path(__file__).resolve().with_name(filename)
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load Stage 0 module: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


_runtime = _load("stage0_runtime", "stage0_runtime.py")
_evidence = _load("stage0_evidence", "stage0_evidence.py")
runtime = _runtime
evidence = _evidence

_PROTOCOL = "orche.pytest.events.v1"
_ACK = b"\x06"
_MAX_EVENT_LINE = 2 * 1024 * 1024
_MAX_EVENT_BYTES = 64 * 1024 * 1024
_MAX_DIAGNOSTIC = 256 * 1024
_EVENT_READ_SIZE = 64 * 1024
_POLL_SECONDS = 0.05


def _linux_effective_uid() -> int:
    geteuid = getattr(os, "geteuid", None)
    if not sys.platform.startswith("linux") or not callable(geteuid):
        raise runtime.VerificationError(
            "Stage 0 temporary-parent validation requires Linux"
        )
    return int(geteuid())


@dataclass(frozen=True)
class _Report:
    nodeid: str
    when: str
    outcome: str
    wasxfail: str | None
    longrepr: str | None


@dataclass
class _ProtocolState:
    sequence: int = 0
    hello_seen: bool = False
    collection_seen: bool = False
    finish_seen: bool = False
    collected: tuple[str, ...] = ()
    deselected: tuple[str, ...] = ()
    reports: dict[tuple[str, str], _Report] = field(default_factory=dict)
    checkpoints: list[str] = field(default_factory=list)
    session_exitstatus: int | None = None
    error: BaseException | None = None
    total_bytes: int = 0

    def consume(self, raw: bytes, revalidate: Callable[[], None], ack_fd: int) -> None:
        self.total_bytes += len(raw)
        if self.total_bytes > _MAX_EVENT_BYTES:
            raise runtime.VerificationError("Pytest event stream exceeded trusted size limit")
        if len(raw) > _MAX_EVENT_LINE:
            raise runtime.VerificationError("Pytest event record exceeded trusted line limit")
        try:
            event = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise runtime.VerificationError(f"invalid trusted Pytest event JSON: {exc}") from exc
        if not isinstance(event, dict) or event.get("protocol") != _PROTOCOL:
            raise runtime.VerificationError("invalid trusted Pytest event protocol")
        if event.get("sequence") != self.sequence:
            raise runtime.VerificationError(
                "trusted Pytest event sequence mismatch: "
                f"expected={self.sequence}, actual={event.get('sequence')!r}"
            )
        self.sequence += 1
        kind = event.get("kind")
        if kind == "hello":
            if self.hello_seen or self.collection_seen:
                raise runtime.VerificationError("duplicate or late trusted Pytest hello")
            self.hello_seen = True
            return
        if not self.hello_seen:
            raise runtime.VerificationError("trusted Pytest event arrived before hello")
        if kind == "collection":
            if self.collection_seen or self.reports or self.checkpoints:
                raise runtime.VerificationError("duplicate or late trusted Pytest collection")
            collected = event.get("collected")
            deselected = event.get("deselected")
            if (
                not isinstance(collected, list)
                or not collected
                or any(not isinstance(item, str) or not item for item in collected)
                or len(set(collected)) != len(collected)
            ):
                raise runtime.VerificationError("invalid trusted Pytest collected node IDs")
            if (
                not isinstance(deselected, list)
                or any(not isinstance(item, str) or not item for item in deselected)
                or len(set(deselected)) != len(deselected)
            ):
                raise runtime.VerificationError("invalid trusted Pytest deselected node IDs")
            self.collected = tuple(collected)
            self.deselected = tuple(deselected)
            self.collection_seen = True
            return
        if not self.collection_seen:
            raise runtime.VerificationError("trusted Pytest result arrived before collection")
        if kind == "report":
            nodeid = event.get("nodeid")
            when = event.get("when")
            outcome = event.get("outcome")
            wasxfail = event.get("wasxfail")
            longrepr = event.get("longrepr")
            if nodeid not in self.collected:
                raise runtime.VerificationError(f"report for uncollected Pytest node: {nodeid!r}")
            if when not in {"setup", "call", "teardown"}:
                raise runtime.VerificationError(f"invalid Pytest report phase: {when!r}")
            if outcome not in {"passed", "failed", "skipped"}:
                raise runtime.VerificationError(f"invalid Pytest report outcome: {outcome!r}")
            if wasxfail is not None and not isinstance(wasxfail, str):
                raise runtime.VerificationError("invalid Pytest expected-failure diagnostic")
            if longrepr is not None and not isinstance(longrepr, str):
                raise runtime.VerificationError("invalid Pytest long representation")
            if isinstance(longrepr, str) and len(longrepr.encode("utf-8")) > _MAX_DIAGNOSTIC:
                raise runtime.VerificationError("Pytest diagnostic exceeded trusted size limit")
            key = (nodeid, when)
            if key in self.reports:
                raise runtime.VerificationError(f"duplicate Pytest report phase: {key!r}")
            self.reports[key] = _Report(nodeid, when, outcome, wasxfail, longrepr)
            return
        if kind == "checkpoint":
            nodeid = event.get("nodeid")
            expected_index = len(self.checkpoints)
            if expected_index >= len(self.collected) or nodeid != self.collected[expected_index]:
                raise runtime.VerificationError(
                    "trusted Pytest checkpoint order mismatch: "
                    f"index={expected_index}, nodeid={nodeid!r}"
                )
