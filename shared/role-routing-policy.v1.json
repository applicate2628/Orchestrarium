      "effort": "max",
      "codexModel": "gpt-5.6-sol"
    }
  },
  "taskClasses": {
    "micro": {
      "requiredModelTier": "mechanical",
      "requiredEffort": "low",
      "mutationClass": "read-only"
    },
    "mechanical-read": {
      "requiredModelTier": "mechanical",
      "requiredEffort": "medium",
      "mutationClass": "read-only"
    },
    "mechanical": {
      "requiredModelTier": "mechanical",
      "requiredEffort": "medium",
      "mutationClass": "bounded-write"
    },
    "exploration": {
      "requiredModelTier": "balanced",
      "requiredEffort": "high",
      "mutationClass": "read-only"
    },
    "engineering": {
      "requiredModelTier": "balanced",
      "requiredEffort": "high",
      "mutationClass": "bounded-write"
    },
    "planning": {
      "requiredModelTier": "balanced",
      "requiredEffort": "high",
      "mutationClass": "read-only"
    },
    "review": {
      "requiredModelTier": "balanced",
      "requiredEffort": "high",
      "mutationClass": "read-only"
    },
    "critical-design": {
      "requiredModelTier": "frontier",
