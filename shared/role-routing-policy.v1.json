    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "finalAuthorizingRoles": [
    "architecture-reviewer",
    "security-reviewer"
  ],
  "profiles": {
    "luna-high": {
      "modelTier": "mechanical",
      "effort": "high",
