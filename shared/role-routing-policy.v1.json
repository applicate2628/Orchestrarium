  "roles": {
    "mechanical-scout": {
      "defaultProfile": "luna-high",
      "allowedProfiles": ["luna-high"]
    },
    "mechanical-worker": {
      "defaultProfile": "luna-high",
      "allowedProfiles": ["luna-high"]
    },
    "default": {
      "defaultProfile": "frontier-xhigh",
      "allowedProfiles": ["balanced-high", "frontier-high", "frontier-xhigh", "apex-max"]
    },
    "explorer": {
      "defaultProfile": "balanced-high",
      "allowedProfiles": ["balanced-medium", "balanced-high", "frontier-high"]
    },
    "worker": {
      "defaultProfile": "frontier-high",
      "allowedProfiles": ["balanced-medium", "balanced-high", "frontier-high", "frontier-xhigh"]
    },
    "analyst": {
      "defaultProfile": "balanced-high",
      "allowedProfiles": ["balanced-high", "frontier-high", "frontier-xhigh"]
    },
    "planner": {
      "defaultProfile": "balanced-high",
      "allowedProfiles": ["balanced-high", "frontier-high", "frontier-xhigh"]
    },
    "architect": {
      "defaultProfile": "frontier-xhigh",
      "allowedProfiles": ["frontier-high", "frontier-xhigh", "apex-max"]
    },
    "architecture-reviewer": {
      "defaultProfile": "frontier-xhigh",
      "allowedProfiles": ["frontier-xhigh", "apex-max"]
    },
    "algorithm-scientist": {
      "defaultProfile": "frontier-xhigh",
      "allowedProfiles": ["frontier-xhigh", "apex-max"]
