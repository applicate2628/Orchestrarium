# Keep the always-loaded governance spine LF-only. CRLF line endings inflate its
# on-disk character count past Claude Code's 40,000-char context-file warning
# even though the rule content is well under the cap and the spine validator
# (which reads with universal-newline normalization) measures it as 39,891.
# Diagnosed 2026-06-10: 147 CRLF pairs pushed the on-disk count to 40,038 chars;
# LF -> 39,891. eol=lf prevents an editor/tool from silently re-introducing CRLF.
shared/AGENTS.shared.md text eol=lf
shared/references/spine/*.md text eol=lf

# These files participate in exact content hashes or loaded-document byte budgets.
# Scope LF checkout to their owners; do not renormalize unrelated source files.
shared/role-routing-policy.v1.json text eol=lf
src.codex/agents/*.toml text eol=lf
shared/agents-mode.presets.json text eol=lf
src.claude/CLAUDE.md text eol=lf
references-claude/claude-md-structural-enforcement.md text eol=lf
references-claude/ru/claude-md-structural-enforcement.md text eol=lf

# Historical accepted-prior payloads preserve their source blob bytes, including CRLF.
# Revision manifests remain text; only files inside each skill payload are byte-exact.
tests/fixtures/canonical-skill-priors/*/*/** -text
