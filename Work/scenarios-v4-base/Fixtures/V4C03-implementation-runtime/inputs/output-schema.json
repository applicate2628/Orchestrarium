{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_id": {"const": "V4C03-implementation-runtime"},
    "cases": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/case"}},
        {"type": "object", "additionalProperties": {"type": "object", "properties": {"outcome": {"type": ["integer", "string"]}}, "required": ["outcome"]}}
      ]
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["routes", "events"]
    },
    "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tests": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/test"}},
        {"type": "object", "additionalProperties": {"type": "object", "properties": {"outcome": {"enum": ["PASS", "FAIL"]}}, "required": ["outcome"]}}
      ]
    },
    "narrative": {"type": "string"}
  },
  "required": ["scenario_id", "cases", "interfaces", "changed_paths", "tests"],
  "$defs": {
    "case": {"type": "object", "properties": {"case_id": {"enum": ["R1", "R2", "R3", "R4", "R5"]}, "outcome": {"type": ["integer", "string"]}}, "required": ["case_id", "outcome"]},
    "test": {"type": "object", "properties": {"test_id": {"const": "T1"}, "outcome": {"enum": ["PASS", "FAIL"]}}, "required": ["test_id", "outcome"]}
  }
}
