{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "const": "V4L09F-pre-pr-review"
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correctness-state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "reliability-retry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "security-auth": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "performance-query": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "correctness-state",
        "reliability-retry",
        "security-auth",
        "performance-query"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/source_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding_map_value"
          }
        },
        "conflict_resolution": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/source_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/conflict_basis_map_value"
          }
        },
        "weak_evidence": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/source_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/weak_basis_map_value"
          }
        },
        "dependencies": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/source_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency_map_value"
          }
        },
        "cross_diff_bindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/source_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding_map_value"
          }
        }
      },
      "required": [
        "bindings",
        "conflict_resolution",
        "weak_evidence",
        "dependencies",
        "cross_diff_bindings"
      ]
    },
    "known_safe_surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "uniqueItems": true
    },
    "review_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "uniqueItems": true
    },
    "rejected_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "uniqueItems": true
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merge_clearance": {
          "$ref": "#/$defs/merge_clearance"
        }
      },
      "required": [
        "merge_clearance"
      ]
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/source_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action_map_value"
      }
    },
    "profile_measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permission_lookup_calls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "const": "calls"
            }
          },
          "required": [
            "value",
            "unit"
          ]
        }
      },
      "required": [
        "permission_lookup_calls"
      ]
    }
  },
  "required": [
    "scenario_id",
    "findings",
    "evidence",
    "known_safe_surfaces",
    "review_scope",
    "rejected_sources",
    "review_gate",
    "actions",
    "profile_measurements"
  ],
  "$defs": {
    "source_id": {
      "type": "string",
      "enum": [
        "F-CARD-101",
        "F-CARD-102",
        "F-CARD-103",
        "F-CARD-201",
        "F-CARD-202",
        "F-CARD-301",
        "F-CARD-302",
        "F-CARD-401",
        "F-CARD-402",
        "F-CARD-501",
        "F-CARD-502",
        "F-CARD-601",
        "F-CARD-602"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
    },
    "severity": {
      "type": "string",
      "pattern": "^(?:[Hh][Ii][Gg][Hh]|[Mm][Ee][Dd][Ii][Uu][Mm]|[Ll][Oo][Ww])$"
    },
    "outcome": {
      "type": "string",
      "pattern": "^(?:[Ff][Ii][Xx]\\-[Bb][Ee][Ff][Oo][Rr][Ee]\\-[Mm][Ee][Rr][Gg][Ee]|[Aa][Dd][Dd]\\-[Rr][Ee][Gg][Rr][Ee][Ss][Ss][Ii][Oo][Nn]\\-[Tt][Ee][Ss][Tt]|[Oo][Pp][Tt][Ii][Mm][Ii][Zz][Ee]\\-[Bb][Ee][Ff][Oo][Rr][Ee]\\-[Mm][Ee][Rr][Gg][Ee]|[Mm][Ee][Aa][Ss][Uu][Rr][Ee]\\-[Bb][Ee][Ff][Oo][Rr][Ee]\\-[Mm][Ee][Rr][Gg][Ee]|[Bb][Ll][Oo][Cc][Kk]\\-[Mm][Ee][Rr][Gg][Ee]|[Aa][Ll][Ll][Oo][Ww]|[Nn][Oo]\\-[Aa][Cc][Tt][Ii][Oo][Nn])$"
    },
    "merge_clearance": {
      "type": "string",
      "pattern": "^(?:[Nn][Ee][Ee][Dd][Ss]\\-[Rr][Ee][Vv][Ii][Ee][Ww]|[Nn][Oo]\\-[Oo][Pp][Ii][Nn][Ii][Oo][Nn]|[Ss][Aa][Ff][Ee]\\-[Tt][Oo]\\-[Mm][Ee][Rr][Gg][Ee]|[Aa][Pp][Pp][Rr][Oo][Vv][Ee][Dd]|[Ss][Hh][Ii][Pp]\\-[Ii][Tt])$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor_source_id": {
          "$ref": "#/$defs/source_id"
        },
        "file": {
          "$ref": "#/$defs/path"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      },
      "required": [
        "anchor_source_id",
        "file",
        "symbol",
        "severity"
      ]
    },
    "binding_map_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source_ids"
      ]
    },
    "action_map_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      },
      "required": [
        "outcome"
      ]
    },
    "conflict_basis": {
      "type": "string",
      "enum": [
        "runtime-repro",
        "static-check",
        "insufficient-evidence"
      ]
    },
    "weak_basis": {
      "type": "string",
      "enum": [
        "dependent-on-state-corruption",
        "independent-defect",
        "insufficient-evidence"
      ]
    },
    "conflict_basis_map_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/conflict_basis"
        }
      },
      "required": [
        "basis"
      ]
    },
    "weak_basis_map_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/weak_basis"
        }
      },
      "required": [
        "basis"
      ]
    },
    "dependency_map_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "$ref": "#/$defs/source_id"
        }
      },
      "required": [
        "depends_on"
      ]
    }
  }
}
