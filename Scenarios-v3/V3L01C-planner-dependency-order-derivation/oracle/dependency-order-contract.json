    "overlay_flags": [
      "planner",
      "hidden-derivation",
      "order-witness"
    ]
  },
  "required_bundle_paths": [
    "README.md",
    "scenario.yaml",
    "discrimination.yaml",
    "inputs/README.md",
    "inputs/task.md",
    "inputs/workitems.json",
    "inputs/constraints.md",
    "candidate/README.md",
