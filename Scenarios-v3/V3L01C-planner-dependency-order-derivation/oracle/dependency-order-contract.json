  ],
  "disallowed_markers": [
    "c-cache can start before d-auth",
    "only the explicit Depends-on edges matter",
    "no derived dependencies"
  ],
  "expected_start_state_failures": [
    "contains-disallowed-markers",
    "missing-required-phrases",
    "missing-required-sections",
    "missing-required-tables",
    "witness-critical-path-length",
